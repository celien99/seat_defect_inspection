<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Benchmark Report — {{ meta.report_title }}</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; line-height: 1.6; color: #333; max-width: 1100px; margin: 0 auto; padding: 20px; background: #f8f9fa; }
  h1 { font-size: 28px; margin-bottom: 8px; color: #1a1a2e; }
  h2 { font-size: 22px; margin: 30px 0 12px; padding-bottom: 6px; border-bottom: 2px solid #3498db; color: #1a1a2e; }
  h3 { font-size: 18px; margin: 20px 0 8px; color: #2c3e50; }
  .meta { color: #7f8c8d; font-size: 14px; margin-bottom: 20px; }
  .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin: 16px 0; }
  .kpi-card { background: white; border-radius: 8px; padding: 16px; text-align: center; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
  .kpi-card .value { font-size: 32px; font-weight: bold; color: #3498db; }
  .kpi-card .value.ok { color: #27ae60; }
  .kpi-card .value.ng { color: #e74c3c; }
  .kpi-card .label { font-size: 13px; color: #7f8c8d; margin-top: 4px; }
  table { width: 100%; border-collapse: collapse; margin: 12px 0; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
  th, td { padding: 10px 14px; text-align: left; border-bottom: 1px solid #eee; font-size: 14px; }
  th { background: #2c3e50; color: white; font-weight: 600; }
  tr:hover { background: #f8f9fa; }
  .chart { margin: 20px 0; text-align: center; }
  .chart img { max-width: 100%; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
  .failure-case { background: white; border-radius: 8px; padding: 14px; margin: 10px 0; box-shadow: 0 1px 4px rgba(0,0,0,0.08); border-left: 4px solid #e74c3c; }
  .failure-case .miss { border-left-color: #e74c3c; }
  .failure-case .fp { border-left-color: #f39c12; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; }
  .badge.ok { background: #d5f5e3; color: #27ae60; }
  .badge.ng { background: #fadbd8; color: #e74c3c; }
  .badge.reject { background: #fdebd0; color: #e67e22; }
  .section-desc { color: #7f8c8d; font-size: 14px; margin-bottom: 10px; }
  .toc { background: white; border-radius: 8px; padding: 16px 20px; margin: 16px 0; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
  .toc a { color: #3498db; text-decoration: none; }
  .toc li { margin: 4px 0; font-size: 14px; }
  .footer { text-align: center; color: #95a5a6; font-size: 12px; margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; }
  @media print { body { background: white; } .chart img { box-shadow: none; } }
</style>
</head>
<body>

<h1>{{ meta.report_title }}</h1>
<div class="meta">
  Generated: {{ meta.generated_at }} | Cameras: {{ meta.camera_ids | join(", ") }} | Config: {{ meta.config_path }}
</div>

{# Table of Contents #}
<div class="toc">
  <strong>Contents</strong>
  <ol>
    <li><a href="#executive-summary">Executive Summary (执行摘要)</a></li>
    <li><a href="#test-scenario">Test Scenario (测试场景)</a></li>
    <li><a href="#dataset-composition">Dataset Composition (数据构成)</a></li>
    <li><a href="#overall-metrics">Overall Metrics (总体指标)</a></li>
    <li><a href="#per-camera">Per-Camera Analysis (按机位分析)</a></li>
    <li><a href="#defect-type">Per-Defect-Type Analysis (按缺陷类型分析)</a></li>
    {% if roc_chart %}
    <li><a href="#roc-pr">ROC &amp; PR Curves (ROC与PR曲线)</a></li>
    {% endif %}
    <li><a href="#score-distribution">Score Distribution (分值分布)</a></li>
    <li><a href="#timing">Timing Analysis (推理耗时)</a></li>
    <li><a href="#failure-cases">Failure Cases (失败案例分析)</a></li>
    <li><a href="#recommendations">Recommendations (优化建议)</a></li>
  </ol>
</div>

{# 1. Executive Summary #}
<h2 id="executive-summary">1. Executive Summary (执行摘要)</h2>
<div class="kpi-grid">
  {% for kpi in kpi_cards %}
  <div class="kpi-card">
    <div class="value{% if kpi.css_class %} {{ kpi.css_class }}{% endif %}">{{ kpi.value }}</div>
    <div class="label">{{ kpi.label }}</div>
  </div>
  {% endfor %}
</div>
<p class="section-desc">{{ executive_summary_text }}</p>

{# 2. Test Scenario #}
<h2 id="test-scenario">2. Test Scenario (测试场景)</h2>
<div class="section-desc">
  <strong>Test methodology:</strong> {{ test_method }}
</div>
<table>
  <tr><th>Parameter</th><th>Value</th></tr>
  <tr><td>Model Pipeline</td><td>YOLO detection → ROI refine → Quality guard → PatchCore texture → Multi-camera fusion</td></tr>
  <tr><td>Test Rounds</td><td>{{ meta.round_names | join(", ") }}</td></tr>
  <tr><td>Camera Count</td><td>{{ meta.camera_ids | length }}</td></tr>
  <tr><td>Fusion Strategy</td><td>{{ meta.fusion_strategy }}</td></tr>
  <tr><td>Threshold Sweep</td><td>{{ "Yes" if meta.threshold_sweep_enabled else "No" }}</td></tr>
</table>

{# 3. Dataset Composition #}
<h2 id="dataset-composition">3. Dataset Composition (数据构成)</h2>
<table>
  <tr>
    <th>Round</th>
    <th>Total Samples</th>
    <th>OK (Normal)</th>
    <th>NG (Defective)</th>
    <th>Ground Truth Source</th>
  </tr>
  {% for comp in compositions %}
  <tr>
    <td>{{ comp.round_name }}</td>
    <td>{{ comp.sample_count }}</td>
    <td>{{ comp.ok_count }}</td>
    <td>{{ comp.ng_count }}</td>
    <td>{{ comp.ground_truth_source }}</td>
  </tr>
  {% endfor %}
</table>

{# 4. Overall Metrics per Round #}
<h2 id="overall-metrics">4. Overall Metrics (总体指标)</h2>
{% for round_name, metrics in round_metrics.items() %}
<h3>4.{{ loop.index }} {{ round_name }}</h3>
{% if metrics %}
<div class="kpi-grid">
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(metrics.precision * 100) }}%</div><div class="label">Precision (精准率)</div></div>
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(metrics.recall * 100) }}%</div><div class="label">Recall (召回率)</div></div>
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(metrics.f1 * 100) }}%</div><div class="label">F1 Score</div></div>
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(metrics.accuracy * 100) }}%</div><div class="label">Accuracy (准确率)</div></div>
  <div class="kpi-card"><div class="value ng">{{ "%0.1f" | format(metrics.miss_rate * 100) }}%</div><div class="label">Miss Rate (漏检率)</div></div>
  <div class="kpi-card"><div class="value ng">{{ "%0.1f" | format(metrics.false_alarm_rate * 100) }}%</div><div class="label">False Alarm (错检率)</div></div>
</div>
<p>
  TP={{ round_data[round_name].confusion.tp }}
  TN={{ round_data[round_name].confusion.tn }}
  FP={{ round_data[round_name].confusion.fp }}
  FN={{ round_data[round_name].confusion.fn }}
</p>
{% if round_data[round_name].confusion.total > 0 %}
<div class="chart"><img src="data:image/png;base64,{{ cm_charts[round_name] }}" alt="Confusion Matrix - {{ round_name }}"></div>
{% endif %}
{% else %}
<p>No ground truth available for this round.</p>
{% endif %}
{% endfor %}

{# Combined Metrics #}
{% if combined_metrics %}
<h3>Combined (All Labeled Rounds)</h3>
<div class="kpi-grid">
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(combined_metrics.precision * 100) }}%</div><div class="label">Precision (精准率)</div></div>
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(combined_metrics.recall * 100) }}%</div><div class="label">Recall (召回率)</div></div>
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(combined_metrics.f1 * 100) }}%</div><div class="label">F1 Score</div></div>
  <div class="kpi-card"><div class="value ng">{{ "%0.1f" | format(combined_metrics.miss_rate * 100) }}%</div><div class="label">Miss Rate (漏检率)</div></div>
  <div class="kpi-card"><div class="value ng">{{ "%0.1f" | format(combined_metrics.false_alarm_rate * 100) }}%</div><div class="label">False Alarm (错检率)</div></div>
</div>
{% endif %}

{# 5. Per-Camera Analysis #}
<h2 id="per-camera">5. Per-Camera Analysis (按机位分析)</h2>
{% for cam_id, cam_metrics in per_camera_metrics.items() %}
<h3>{{ cam_id }}</h3>
{% set cm_row = per_camera_confusions[cam_id] %}
<table>
  <tr><th>Metric</th><th>Value</th><th>95% CI</th></tr>
  <tr><td>Precision</td><td>{{ "%0.1f" | format(cam_metrics.precision * 100) }}%</td><td>—</td></tr>
  <tr><td>Recall</td><td>{{ "%0.1f" | format(cam_metrics.recall * 100) }}%</td><td>—</td></tr>
  <tr><td>F1</td><td>{{ "%0.1f" | format(cam_metrics.f1 * 100) }}%</td><td>—</td></tr>
  <tr><td>TP/TN/FP/FN</td><td colspan="2">{{ cm_row.tp }} / {{ cm_row.tn }} / {{ cm_row.fp }} / {{ cm_row.fn }}</td></tr>
</table>
{% endfor %}
{% if per_camera_chart %}
<div class="chart"><img src="data:image/png;base64,{{ per_camera_chart }}" alt="Per-Camera Metrics Chart"></div>
{% endif %}

{# 6. Defect-Type Analysis #}
<h2 id="defect-type">6. Per-Defect-Type Analysis (按缺陷类型分析)</h2>
{% if defect_type_data %}
<table>
  <tr><th>Defect Type</th><th>Total</th><th>Detected</th><th>Recall</th><th>Precision</th><th>F1</th></tr>
  {% for dt in defect_type_data %}
  <tr>
    <td>{{ dt.defect_type }}</td>
    <td>{{ dt.total }}</td>
    <td>{{ dt.detected }}</td>
    <td>{{ "%0.1f" | format(dt.recall * 100) }}%</td>
    <td>{{ "%0.1f" | format(dt.precision * 100) }}%</td>
    <td>{{ "%0.1f" | format(dt.f1 * 100) }}%</td>
  </tr>
  {% endfor %}
</table>
{% if defect_type_chart %}
<div class="chart"><img src="data:image/png;base64,{{ defect_type_chart }}" alt="Defect Type Chart"></div>
{% endif %}
{% else %}
<p>No defect-type labels available in ground truth.</p>
{% endif %}

{# 7. ROC & PR Curves #}
{% if roc_chart %}
<h2 id="roc-pr">7. ROC &amp; PR Curves (ROC与PR曲线)</h2>
<h3>ROC Curve (AUC = {{ "%.4f" | format(roc_auc) }})</h3>
<div class="chart"><img src="data:image/png;base64,{{ roc_chart }}" alt="ROC Curve"></div>
<h3>PR Curve (AUC = {{ "%.4f" | format(pr_auc) }})</h3>
<div class="chart"><img src="data:image/png;base64,{{ pr_chart }}" alt="PR Curve"></div>
{% endif %}

{# 8. Score Distribution #}
<h2 id="score-distribution">8. Score Distribution (分值分布)</h2>
{% if score_dist_chart %}
<div class="chart"><img src="data:image/png;base64,{{ score_dist_chart }}" alt="Score Distribution"></div>
{% endif %}
<table>
  <tr><th>Class</th><th>Count</th><th>Min</th><th>Max</th><th>Mean</th><th>Median</th><th>Std</th><th>P5</th><th>P95</th></tr>
  {% for dist in score_dists %}
  <tr>
    <td>{{ dist.label }}</td>
    <td>{{ dist.count }}</td>
    <td>{{ "%.4f" | format(dist.min) }}</td>
    <td>{{ "%.4f" | format(dist.max) }}</td>
    <td>{{ "%.4f" | format(dist.mean) }}</td>
    <td>{{ "%.4f" | format(dist.median) }}</td>
    <td>{{ "%.4f" | format(dist.std) }}</td>
    <td>{{ "%.4f" | format(dist.p5) }}</td>
    <td>{{ "%.4f" | format(dist.p95) }}</td>
  </tr>
  {% endfor %}
</table>

{# 9. Timing Analysis #}
<h2 id="timing">9. Timing Analysis (推理耗时)</h2>
{% if timing_data %}
<div class="kpi-grid">
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(timing_data.mean_ms) }}ms</div><div class="label">Mean (平均)</div></div>
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(timing_data.std_ms) }}ms</div><div class="label">Std (标准差)</div></div>
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(timing_data.p50_ms) }}ms</div><div class="label">P50 (中位数)</div></div>
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(timing_data.p95_ms) }}ms</div><div class="label">P95</div></div>
  <div class="kpi-card"><div class="value">{{ "%0.1f" | format(timing_data.p99_ms) }}ms</div><div class="label">P99</div></div>
</div>
<table>
  <tr><th>Stat</th><th>Value</th></tr>
  <tr><td>Min</td><td>{{ "%0.1f" | format(timing_data.min_ms) }}ms</td></tr>
  <tr><td>Max</td><td>{{ "%0.1f" | format(timing_data.max_ms) }}ms</td></tr>
  <tr><td>Samples</td><td>{{ timing_data.all_timings_ms | length }}</td></tr>
</table>
{% endif %}

{# 10. Failure Cases #}
<h2 id="failure-cases">10. Failure Cases (失败案例分析)</h2>
{% set miss_count = failure_cases | selectattr("sample.ground_truth_label", "equalto", "NG") | selectattr("predicted_status", "equalto", "OK") | list | length %}
{% set fp_count = failure_cases | selectattr("sample.ground_truth_label", "equalto", "OK") | selectattr("predicted_status", "equalto", "NG") | list | length %}
<p>Total failure cases: {{ failure_cases | length }} (Missed NG: {{ miss_count }}, False Positives: {{ fp_count }})</p>

{% for fc in failure_cases %}
<div class="failure-case">
  <strong>
    {% if fc.sample.ground_truth_label == "NG" and fc.predicted_status == "OK" %}
    <span class="badge ng">MISS (漏检)</span>
    {% else %}
    <span class="badge reject">FALSE POSITIVE (误报)</span>
    {% endif %}
    {{ fc.sample.part_id }}
  </strong>
  <br>
  GT: {{ fc.sample.ground_truth_label }} → Predicted: {{ fc.predicted_status }} | Reason: {{ fc.decision_reason }}
  <br>
  {% if fc.sample.ground_truth_defect_type %}Defect type: {{ fc.sample.ground_truth_defect_type }}{% endif %}
  {% if fc.sample.ground_truth_severity %} | Severity: {{ fc.sample.ground_truth_severity }}{% endif %}
  <br>
  Images:
  {% for cid, path in fc.sample.image_paths.items() %}
    {{ cid }}={{ path }}
  {% endfor %}
  <br>
  Camera scores:
  {% for cam in fc.camera_records %}
    {{ cam.camera_id }}={% if cam.anomaly_score is not none %}{{ "%.4f" | format(cam.anomaly_score) }}{% else %}N/A{% endif %}
    {% if cam.is_anomaly is not none %}[Anomaly: {{ cam.is_anomaly }}]{% endif %}
  {% endfor %}
</div>
{% endfor %}
{% if not failure_cases %}
<p>No failure cases found. All samples correctly classified.</p>
{% endif %}

{# 11. Recommendations #}
<h2 id="recommendations">11. Recommendations (优化建议)</h2>
{% for rec in recommendations %}
<div class="failure-case" style="border-left-color: #3498db;">
  <strong>{{ rec.title }}</strong>
  <p>{{ rec.body }}</p>
</div>
{% endfor %}

<div class="footer">
  Generated by seat-defect-inspection benchmark | {{ meta.generated_at }}
</div>

</body>
</html>
