{
  "seat_defect_inspection": {
    "part_id": "seat_demo",
    "default_seat_model_id": "seat_model_a",
    "output_json_path": "../outputs/seat_defect_inspection/multimodel_results.json",
    "debug_dir": "../outputs/seat_defect_inspection/multimodel_debug",
    "debug_artifacts_enabled": false,
    "fusion": {
      "reject_on_any_reject": true,
      "ng_strategy": "any",
      "early_stop_on_ng": false,
      "defect_overrides_reject": true
    },
    "seat_models": [
      {
        "seat_model_id": "seat_model_a",
        "display_name": "座椅型号A",
        "yolo_training": {
          "model_path": "yolo11m-seg.pt",
          "data_config_path": "../configs/seat_defect_yolo.dataset.example.yaml",
          "project": "../outputs/yolo_training",
          "name": "seat_model_a"
        },
        "cameras": [
          {
            "camera_id": "cam_front",
            "source": "mvs://sn/REPLACE_MODEL_A_CAM_FRONT?timeout_ms=1000",
            "patchcore_model_path": "../models/seat_defect_inspection/seat_model_a/cam_front_patchcore.npz",
            "color_insensitive_mode": true,
            "detection": {
              "model_path": "../models/seat_defect_inspection/yolo/seat_model_a_best.pt",
              "target_class": "seat",
              "fallback_box": {
                "x1": 900,
                "y1": 280,
                "x2": 2600,
                "y2": 2400
              }
            },
            "roi": {
              "crop_expand_ratio": 0.02,
              "mask_erode_pixels": 1,
              "edge_ignore_pixels": 4,
              "alignment": {
                "output_width": 256,
                "output_height": 256
              }
            },
            "patchcore": {
              "backend": "full",
              "backbone_name": "wide_resnet50_2",
              "feature_layers": [
                "layer2",
                "layer3"
              ],
              "backbone_pretrained": true,
              "backbone_device": "cpu",
              "coreset_sampling_ratio": 0.1,
              "texture_input": "lab_l",
              "min_target_coverage": 0.6,
              "min_valid_patch_ratio": 0.4
            },
            "color_branch": {
              "enabled": false
            },
            "regions": [
              {
                "region_id": "upper",
                "box": [
                  0.03,
                  0.03,
                  0.97,
                  0.42
                ],
                "patchcore_model_path": "../models/seat_defect_inspection/seat_model_a/cam_front_upper_patchcore.npz"
              },
              {
                "region_id": "middle",
                "box": [
                  0.03,
                  0.33,
                  0.97,
                  0.74
                ],
                "patchcore_model_path": "../models/seat_defect_inspection/seat_model_a/cam_front_middle_patchcore.npz"
              },
              {
                "region_id": "lower",
                "box": [
                  0.03,
                  0.66,
                  0.97,
                  0.97
                ],
                "patchcore_model_path": "../models/seat_defect_inspection/seat_model_a/cam_front_lower_patchcore.npz"
              }
            ]
          }
        ]
      },
      {
        "seat_model_id": "seat_model_b",
        "display_name": "座椅型号B",
        "yolo_training": {
          "model_path": "yolo11m-seg.pt",
          "data_config_path": "../configs/seat_defect_yolo.dataset.example.yaml",
          "project": "../outputs/yolo_training",
          "name": "seat_model_b"
        },
        "cameras": [
          {
            "camera_id": "cam_front",
            "source": "mvs://sn/REPLACE_MODEL_B_CAM_FRONT?timeout_ms=1000",
            "patchcore_model_path": "../models/seat_defect_inspection/seat_model_b/cam_front_patchcore.npz",
            "color_insensitive_mode": true,
            "detection": {
              "model_path": "../models/seat_defect_inspection/yolo/seat_model_b_best.pt",
              "target_class": "seat",
              "fallback_box": {
                "x1": 860,
                "y1": 260,
                "x2": 2540,
                "y2": 2360
              }
            },
            "roi": {
              "crop_expand_ratio": 0.02,
              "mask_erode_pixels": 1,
              "edge_ignore_pixels": 4,
              "alignment": {
                "output_width": 256,
                "output_height": 256
              }
            },
            "patchcore": {
              "backend": "full",
              "backbone_name": "wide_resnet50_2",
              "feature_layers": [
                "layer2",
                "layer3"
              ],
              "backbone_pretrained": true,
              "backbone_device": "cpu",
              "coreset_sampling_ratio": 0.1,
              "texture_input": "lab_l",
              "min_target_coverage": 0.6,
              "min_valid_patch_ratio": 0.4
            },
            "color_branch": {
              "enabled": false
            },
            "regions": [
              {
                "region_id": "upper",
                "box": [
                  0.03,
                  0.03,
                  0.97,
                  0.42
                ],
                "patchcore_model_path": "../models/seat_defect_inspection/seat_model_b/cam_front_upper_patchcore.npz"
              },
              {
                "region_id": "middle",
                "box": [
                  0.03,
                  0.33,
                  0.97,
                  0.74
                ],
                "patchcore_model_path": "../models/seat_defect_inspection/seat_model_b/cam_front_middle_patchcore.npz"
              },
              {
                "region_id": "lower",
                "box": [
                  0.03,
                  0.66,
                  0.97,
                  0.97
                ],
                "patchcore_model_path": "../models/seat_defect_inspection/seat_model_b/cam_front_lower_patchcore.npz"
              }
            ]
          }
        ]
      }
    ]
  }
}
