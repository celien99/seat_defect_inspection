{
  "seat_defect_inspection": {
    "part_id": "seat_production",
    "output_json_path": "../outputs/seat_defect_inspection/mvs_results.json",
    "debug_dir": "../outputs/seat_defect_inspection/mvs_debug",
    "debug_artifacts_enabled": true,
    "fusion": {
      "reject_on_any_reject": true,
      "ng_strategy": "any",
      "defect_overrides_reject": true
    },
    "yolo_training": {
      "model_path": "../yolo11m-seg.pt",
      "data_config_path": "../datasets/seat_defect/seat_defect.yaml",
      "epochs": 100,
      "imgsz": 1280,
      "batch": 8,
      "device": "0",
      "project": "../outputs/seat_defect_inspection/yolo_training",
      "name": "seat_defect",
      "workers": 4,
      "patience": 20,
      "cache": false,
      "pretrained": true
    },
    "cameras": [
      {
        "camera_id": "cam_0",
        "source": "mvs://sn/DA9184658?timeout_ms=1000&exposure_auto=off&exposure_time=8000",
        "patchcore_model_path": "../models/seat_defect_inspection/cam_0_patchcore.npz",
        "train_good_dir": "../data/seat_defect_inspection/cam_0/train/good",
        "color_insensitive_mode": false,
        "quality": {
          "min_laplacian_variance": 80,
          "min_brightness_mean": 30,
          "max_brightness_mean": 225,
          "max_overexposed_ratio": 0.25,
          "max_underexposed_ratio": 0.35
        },
        "detection": {
          "model_path": "../best.pt",
          "target_class": "seat",
          "confidence": 0.35,
          "iou": 0.45,
          "imgsz": 960,
          "device": "cuda:0"
        },
        "roi": {
          "crop_expand_ratio": 0.04,
          "crop_shrink_ratio": 0,
          "mask_erode_pixels": 1,
